{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SIO",
  "version": "0.1.0",
  "identifier": "dev.myka.sio",
  "build": {
    "beforeDevCommand": "npm run dev:full",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:full",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SIO",
        "width": 1120,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGRkNBRjNFREY3MjY1QjcKUldTM1pYTGZQcS84M3pCb0hzd250bE5McS9ZNkl6cmFXV1VucHgxN2xobm56dll5VmxHOWpjN0UK",
      "endpoints": [
        "https://github.com/MyKa322/sio-myka/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/sio-broker"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian", "Ukrainian"]
      }
    }
  }
}
